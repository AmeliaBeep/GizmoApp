@page "/gizmo"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject HttpClient Http

<h1>Gizmo Opinions</h1>

<button class="btn opinion-button btn-secondary shadow-none" @onclick="GetRandomOpinion">Get random opinion</button>
<br>
<button class="btn gizmo-button shadow-none" @onclick="IncrementGizmo">Make him bigger!</button>
<button class="btn gizmo-button shadow-none" @onclick="ResetGizmo">Reset size</button>
<br>
@if (randomOpinion is not null)
{
    <img src="images/@FileName(randomOpinion.Category)" alt="@randomOpinion.Category gizmo" style="width: @(currentSize)px;" class="gizmo-image" />
    <p>@randomOpinion.Text</p>
} 
else
{
    <img src="images/gizmo_happy.png" alt="Gizmo" style="width: @(currentSize)px;" class="gizmo-image" />
}


@code {
    private Opinion? randomOpinion;
    private const int initialSize = 200;
    private int currentSize = initialSize;
    private void IncrementGizmo()
    {
        currentSize += 50;
    }
    private void ResetGizmo()
    {
        currentSize = initialSize;
    }
    private async Task GetRandomOpinion()
    {
        randomOpinion = await Http.GetFromJsonAsync<Opinion>(
            Navigation.ToAbsoluteUri("api/opinions/random"));
    }
    private static string FileName(OpinionCategory category) 
    {
        return $"gizmo_{category.ToString().ToLower()}.png";
    }
}
